{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": {
            "top": 2
        },
        "type": "file",
        "source":"~/.config/fastfetch/logo.txt"
    },
    "display": {
        "separator": " ⟩ ",
        "constants": [
            "───────────────────────────────"
        ]
    },
      "defaults": {
    "outputColor": "#7700e7"
  },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "┌{$1}[]{$1}┐",
            "outputColor": "#a8a8a8"
        },
        {
            "type": "title",
            "keyWidth": 10
        },
        {
            "type": "custom",
            "format": "├{$1}[]{$1}┤",
            "outputColor": "#a8a8a8"
        },
        //{
        //    "type": "custom",
        //    "format": " {#90}□  {#31}□  {#32}[]  {#33}[]  {#34}[]  {#35}[]  {#36}[]  {#37}[]  {#38}[]  {#39}[]     []  {#38}[]  {#37}[]  {#36}[]  {#35}[]  {#34}[]  {#33}[]  {#32}[]  {#31}[]  {#90}[]"
        //},
        {
            "type": "custom",
            "format": "├{$1}[]{$1}┤",
            "outputColor": "#a8a8a8"
        },
        {
            "type": "os",
            "key": "{icon} OS",
            "keyColor": "#7700e7",
            "outputColor": "#9900ff"
        },
        {
            "type": "kernel",
            "key": "│ ├{icon}",
            "keyColor": "#7700e7",
            "outputColor": "#9900ff"
        },
        {
            "type": "packages",
            "key": "│ ├{icon}",
            "keyColor": "#7700e7",
            "outputColor": "#9900ff"
        },
        {
            "type": "shell",
            "key": "│ └",
            "keyColor": "#7700e7",
            "outputColor": "#9900ff"
        },
        {
            "type": "wm",
            "key": " DE/WM",
            "keyColor": "#5638ff",
            "outputColor": "#9900ff"
        },
        {
            "type": "lm",
            "key": "│ ├{icon}",
            "keyColor": "#5638ff",
            "outputColor": "#9900ff"
        },
        {
            "type": "wmtheme",
            "key": "│ ├{icon}",
            "keyColor": "#5638ff",
            "outputColor": "#9900ff"
        },
        {
            "type": "icons",
            "key": "│ ├{icon}",
            "keyColor": "#5638ff",
            "outputColor": "#9900ff"
        },
        {
            "type": "terminal",
            "key": "│ ├{icon}",
            "keyColor": "#5638ff",
            "outputColor": "#9900ff"
        },
        {
            "type": "cpu",
            "key": "│ ├{icon}",
            "keyColor": "#a277f1",
            "outputColor": "#9900ff"
        },
        {
            "type": "gpu",
            "key": "│ ├{icon}",
            "keyColor": "#a277f1",
            "outputColor": "#9900ff"
        },
        {
            "type": "disk",
            "key": "│ ├{icon}",
            "keyColor": "#a277f1",
            "outputColor": "#9900ff"
        },
        {
            "type": "memory",
            "key": "│ ├{icon}",
            "keyColor": "#a277f1",
            "outputColor": "#9900ff"
        },
        {
            "type": "swap",
            "key": "│ ├{icon}",
            "keyColor": "#a277f1",
            "outputColor": "#9900ff"
        },
        {
            "type": "uptime",
            "key": "│ ├{icon}",
            "keyColor": "#a277f1",
            "outputColor": "#9900ff"
        },
        {
            "type": "display",
            "key": "│ └󰍹",
            "keyColor": "#a277f1",
            "outputColor": "#9900ff"
        },
        {
            "type": "sound",
            "key": " SND",
            "keyColor": "#00c5b5",
            "outputColor": "#9900ff"
        },
        {
            "type": "player",
            "key": "│ ├{icon}",
            "keyColor": "#00c5b5",
            "outputColor": "#9900ff"
        },
        {
            "type": "media",
            "key": "│ └󰝚",
            "keyColor": "#00c5b5",
            "outputColor": "#9900ff"
        },
        {
            "type": "custom",
            "format": "└{$1}[]{$1}┘",
            "outputColor": "#a8a8a8"
        },
        {
          "type": "custom",
          "format": "                 > Don't be Evil, do Open Source <",
          "outputColor": "#7700e7",
        },
        "break",
        "break",
        "break"
    ]
}
